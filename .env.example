# Generated by `npm run setup`. The agent sends this as `Authorization: Bearer <token>`.
AGENT_TOKEN=
# Where the app listens (keep it on loopback).
APP_URL=http://127.0.0.1:3000
# Optional: also write the apply queue (and copies of each job's materials) here, and read the apply agent's
# results from here too. E.g. the Grok bridge folder in iCloud Drive:
# LODESTAR_HANDOFF_DIR=~/Library/Mobile Documents/com~apple~CloudDocs/AI/grok-bridge/lodestar
# Optional: how many unscored jobs one run is given to score (default 80; the most promising go first).
# LODESTAR_SCORE_LIMIT=80
# Optional: score and prepare jobs through the Anthropic Batch API (Console credits, half price) instead of the daily
# Chrome run. Key: here, or the macOS Keychain item "lodestar-anthropic". Not ANTHROPIC_API_KEY (that would sign
# Claude Code out of the claude.ai login Claude in Chrome needs).
# LODESTAR_ANTHROPIC_KEY=
# LODESTAR_BATCH_PREPARE=1            # the Chrome run then leaves jobs with stored posting text to the batch
# LODESTAR_SCORE_MODEL=claude-haiku-5-5
# LODESTAR_MATERIALS_MODEL=claude-sonnet-5-5
# Optional: a local OpenAI-compatible model (Ollama, say) drops clear non-matches before they reach the batch.
# LODESTAR_LOCAL_MODEL_URL=http://127.0.0.1:11434
# LODESTAR_LOCAL_MODEL=qwen3:14b
# The apply worker (scripts/apply-run.sh): jobs per run, minutes per job, model.
# LODESTAR_APPLY_MAX=15
# LODESTAR_APPLY_JOB_MINUTES=15
# LODESTAR_APPLY_MODEL=sonnet
