# Generated by `npm run setup`. The agent sends this as `Authorization: Bearer <token>`.
AGENT_TOKEN=
# Where the app listens (keep it on loopback).
APP_URL=http://127.0.0.1:3000
# Optional: also write the apply queue (and copies of each job's materials) here, and read the apply agent's
# results from here too. E.g. the Grok bridge folder in iCloud Drive:
# LODESTAR_HANDOFF_DIR=~/Library/Mobile Documents/com~apple~CloudDocs/AI/grok-bridge/lodestar
# Optional: how many unscored jobs one run is given to score (default 80; the most promising go first).
# LODESTAR_SCORE_LIMIT=80
