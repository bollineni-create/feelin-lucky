{
  "name": "job-hunt-command-center",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test lib/*.test.ts scripts/mail/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx db/seed.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "docx": "^9.12.0",
    "drizzle-orm": "^0.45.4",
    "marked": "^18.1.1",
    "next": "^15.5.28",
    "pdfkit": "^0.20.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
